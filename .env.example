# Copiar este archivo como .env y completar con valores locales (NO subir .env a GitHub)
PORT=3000

# Conexión a PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=catalogo_db

# JWT: usar una cadena larga y aleatoria
JWT_SECRET=
JWT_EXPIRES_IN=1h

# Administrador inicial (lo crea: npm run db:admin)
ADMIN_NOMBRE=Administrador
ADMIN_EMAIL=admin@catalogo.test
ADMIN_PASSWORD=
